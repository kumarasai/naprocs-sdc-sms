# ========================================================
# NAPROCS SKILL DEVELOPMENT CENTER - ENVIRONMENT TEMPLATE
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# Default connects to local MongoDB instance
MONGODB_URI=mongodb://127.0.0.1:27017/naprocs_lms

# JWT & Security Configuration
JWT_SECRET=naprocs_super_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=naprocs_secure_cookie_secret_hash_987654321

# Attendance System Configuration
# QR rolling code validity in seconds (default 30 seconds)
ATTENDANCE_QR_TTL_SECONDS=30
# HMAC secret for signed QR attendance tokens
ATTENDANCE_SIGNING_KEY=naprocs_qr_attendance_hmac_secret_token_secure_salt_2026
# Cutoff window in minutes after class start time
ATTENDANCE_LATE_THRESHOLD_MINUTES=15
ATTENDANCE_ABSENT_THRESHOLD_MINUTES=45

# Institute Profile Defaults
INSTITUTE_NAME=Naprocs Skill Development Center
INSTITUTE_TIMEZONE=Asia/Kolkata
